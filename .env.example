# Copy to .env.local for local development. Never commit real values.
# Names follow docs/02 §7. NEXT_PUBLIC_* values are shipped to the browser; nothing else is.

# local | preview | staging | production
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Comma list to override change-request flags, e.g. "-dark_home" to see the light home.
NEXT_PUBLIC_FEATURE_FLAGS=

# Supabase. Local values come from `npx supabase start` (Docker).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay TEST keys only until go-live (created inside ColdEasy's Razorpay account).
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Google Analytics 4 (G-XXXXXXX). Empty means no analytics script loads.
NEXT_PUBLIC_GA4_ID=

# Sentry
NEXT_PUBLIC_SENTRY_DSN=

# On-demand revalidation from the admin and Supabase functions (32+ random chars).
REVALIDATE_SECRET=

# Preview and staging only: "user:long-password". Never set in production.
STAGING_BASIC_AUTH=
