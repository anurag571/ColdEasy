{
  "name": "coldeasy-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run gates && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "db:local:test": "bash scripts/db/test-plain-postgres.sh",
    "e2e": "playwright test --trace off",
    "gate:placeholders": "tsx scripts/gates/check-placeholders.ts",
    "gate:claims": "tsx scripts/gates/check-claims.ts",
    "gate:secrets": "tsx scripts/gates/check-secrets.ts",
    "gate:secrets:build": "tsx scripts/gates/check-secrets.ts --build",
    "gate:links": "tsx scripts/gates/check-links.ts",
    "gate:lighthouse": "lhci autorun",
    "gates": "npm run gate:placeholders && npm run gate:claims && npm run gate:secrets"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.2",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@lhci/cli": "0.16.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.19.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.1",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "10.1.8",
    "pg": "8.23.1",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  }
}
