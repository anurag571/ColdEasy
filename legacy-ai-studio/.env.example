# Server-only. Do not add a VITE_ prefix.
# Vite inlines every VITE_ variable into the browser bundle.
# This app does not call Gemini. Leave the value empty.
GEMINI_API_KEY=

# Public site origin. Not read by the app today, so it is not shipped to the browser.
# If a client feature needs it later, rename the copy you read to VITE_APP_URL.
APP_URL=
